# Tomodachi Configuration
# Copy this to .env and customize for your environment

# === Port Configuration ===
# Set these to avoid conflicts with your other projects
TOMO_MEMORY_PORT=5003
TOMO_API_PORT=8080
TOMO_GUI_PORT=5173

# === Model Configuration ===
# Base model (will auto-download from HuggingFace if not present)
TOMO_BASE_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# Adapter paths (optional - will use base model if not found)
TOMO_ORCHESTRATOR_ADAPTER=./ai/orchestrator_adapter
TOMO_PERSONA_ADAPTER=./ai/persona_adapter

# === Memory System ===
TOMO_MEMORY_DB=./memories/data/edge_rag.db
TOMO_MEMORY_INDEX=./memories/data/edge_rag.ann

# === Feature Flags ===
# Enable/disable features based on what's available
TOMO_USE_ADAPTERS=auto  # auto|true|false - auto will check if adapters exist
TOMO_USE_MEMORY=true    # true|false - disable if memory service fails
TOMO_DEBUG=false        # true|false - enable debug logging

# === System Configuration ===
# Uncomment and set if you need custom paths (macOS with Xcode)
# CPLUS_INCLUDE_PATH=/Library/Developer/CommandLineTools/SDKs/MacOSX15.sdk/usr/include/c++/v1

# === Python Environment Notes ===
# IMPORTANT: memories/ has its own .venv with specific Python version for annoy compatibility
# Main project uses venv/
# This is intentional - do not merge them!
